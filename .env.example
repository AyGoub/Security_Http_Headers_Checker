# Recommandations redigees par un modele de langage. Optionnel : sans cle,
# l'outil affiche les recommandations statiques et fonctionne normalement.
#
# Ce fichier est lu automatiquement au demarrage. L'environnement reel reste
# prioritaire sur son contenu.
#
# Cle gratuite, sans carte bancaire : https://console.groq.com/keys
SHHC_AI_KEY=

# Pour changer de fournisseur. Tout service parlant le dialecte
# POST /chat/completions convient.
#
#   Gemini     https://generativelanguage.googleapis.com/v1beta/openai
#              gemini-2.5-flash                      (aistudio.google.com)
#   OpenRouter https://openrouter.ai/api/v1
#              meta-llama/llama-3.3-70b-instruct:free
#   Ollama     http://localhost:11434/v1
#              llama3.1                              (cle bidon suffisante)
#
# Un 404 signifie presque toujours un modele retire du catalogue. La liste a
# jour : GET {SHHC_AI_BASE_URL}/models
#
# SHHC_AI_BASE_URL=https://api.groq.com/openai/v1
# SHHC_AI_MODEL=openai/gpt-oss-120b
